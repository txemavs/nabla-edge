[Unit]
Description=Nabla Edge First-Boot Setup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/boot/nabla-firstboot.flag
ConditionPathExists=|/boot/firmware/nabla-firstboot.flag
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nabla/nabla-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

# Nabla Wi-Fi Credentials Template
# Copy to ~/.config/nabla/wifi.env on the FLASHER machine (not committed to git!)
#
# These credentials are injected at image-write time.
# The imaged Pi will auto-connect to these networks on first boot.
#
# Priority order (higher = tried first):
#   40: wifi_ssid_net (primary fleet network)
#   30: wifi_ssid_go  (mobile hotspot)
#   20: wifi_ssid_villa (site-specific)
#   10: wifi_ssid (fallback)
#
# NEVER commit real passwords to git!

# Network 1: Nabla Net (primary fleet network, priority 40)
wifi_ssid_net="CHANGE_ME"
wifi_password_net="CHANGE_ME"

# Network 2: Nabla Go (mobile hotspot, priority 30)
wifi_ssid_go="CHANGE_ME"
wifi_password_go="CHANGE_ME"

# Network 3: Site-specific (priority 20)
wifi_ssid_villa="CHANGE_ME"
wifi_password_villa="CHANGE_ME"

# Network 4: Generic fallback (priority 10)
wifi_ssid="CHANGE_ME"
wifi_password="CHANGE_ME"

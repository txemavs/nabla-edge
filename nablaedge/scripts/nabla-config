#!/bin/bash
# nabla-config v0.7 — NablaEdge Configuration Panel
# Whiptail-based interactive configuration for Raspberry Pi edge nodes.
#
# SANITIZED REFERENCE COPY — no private hostnames, IPs, or secrets.
# Real values configured via /etc/nabla-net/ files at runtime.

set -e

VERSION="0.7"
CONFIG_DIR="/etc/nabla-net"
ACCESSORIES_CONF="$CONFIG_DIR/accessories.conf"
NETWORK_CONF="$CONFIG_DIR/network.conf"
AP_ENV="$HOME/.config/nabla-net-ap.env"

# Ensure config directory exists
ensure_config_dir() {
    sudo mkdir -p "$CONFIG_DIR"
}

# Load accessories configuration
load_accessories() {
    if [[ -f "$ACCESSORIES_CONF" ]]; then
        source "$ACCESSORIES_CONF"
    else
        # Defaults
        display_oled=0
        rotary=0
        display_large=0
    fi
}

# Save accessories configuration
save_accessories() {
    sudo tee "$ACCESSORIES_CONF" > /dev/null << EOF
# NablaEdge Accessories Configuration
# Generated by nabla-config v$VERSION

# OLED Display (SSD1306 I2C)
display_oled=$display_oled

# Rotary Encoder (GPIO 17/27/22)
rotary=$rotary

# Large SPI Display (optional TFT)
display_large=$display_large
EOF
}

# Load network configuration
load_network() {
    if [[ -f "$NETWORK_CONF" ]]; then
        source "$NETWORK_CONF"
    else
        network_mode="cable"
    fi
}

# ============================================================================
# MAIN MENU
# ============================================================================

main_menu() {
    while true; do
        CHOICE=$(whiptail --title "nabla-config v$VERSION" --menu "NablaEdge Configuration" 18 60 10 \
            "Red" "Network mode and WiFi settings" \
            "Medios" "Audio and video output" \
            "Accesorios" "OLED, rotary encoder, displays" \
            "Cámara" "Camera module settings" \
            "Voz" "Voice satellite (HA Assist)" \
            "Info" "System information" \
            "Salir" "Exit configuration" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "Red") network_menu ;;
            "Medios") media_menu ;;
            "Accesorios") accessories_menu ;;
            "Cámara") camera_menu ;;
            "Voz") voice_menu ;;
            "Info") info_menu ;;
            "Salir") break ;;
        esac
    done
}

# ============================================================================
# RED (NETWORK) MENU
# ============================================================================

network_menu() {
    load_network
    while true; do
        CHOICE=$(whiptail --title "Red — Network Configuration" --menu "Current mode: $network_mode" 16 60 8 \
            "Modo" "Set network mode (cable/ap/cable-ap/off)" \
            "WiFi" "Configure WiFi AP credentials" \
            "Estado" "Show current network status" \
            "Reiniciar" "Restart networking services" \
            "Volver" "Return to main menu" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "Modo") set_network_mode ;;
            "WiFi") configure_wifi_ap ;;
            "Estado") show_network_status ;;
            "Reiniciar") restart_network ;;
            "Volver") break ;;
        esac
    done
}

set_network_mode() {
    MODE=$(whiptail --title "Network Mode" --radiolist "Select network mode:" 14 60 4 \
        "cable" "WiFi uplink + Ethernet LAN + NAT" $([[ "$network_mode" == "cable" ]] && echo "ON" || echo "OFF") \
        "ap" "Ethernet uplink + WiFi AP" $([[ "$network_mode" == "ap" ]] && echo "ON" || echo "OFF") \
        "cable-ap" "Ethernet LAN + second radio AP" $([[ "$network_mode" == "cable-ap" ]] && echo "ON" || echo "OFF") \
        "off" "Networking disabled" $([[ "$network_mode" == "off" ]] && echo "ON" || echo "OFF") \
        3>&1 1>&2 2>&3) || return

    network_mode="$MODE"
    sudo tee "$NETWORK_CONF" > /dev/null << EOF
# NablaEdge Network Configuration
network_mode=$network_mode
EOF

    whiptail --msgbox "Network mode set to: $network_mode\n\nRun 'Reiniciar' to apply changes." 10 50
}

configure_wifi_ap() {
    mkdir -p "$(dirname "$AP_ENV")"

    SSID=$(whiptail --inputbox "WiFi AP SSID:" 8 50 "NablaNet" 3>&1 1>&2 2>&3) || return
    PASSWORD=$(whiptail --passwordbox "WiFi AP Password (min 8 chars):" 8 50 3>&1 1>&2 2>&3) || return

    if [[ ${#PASSWORD} -lt 8 ]]; then
        whiptail --msgbox "Password must be at least 8 characters." 8 50
        return
    fi

    cat > "$AP_ENV" << EOF
# NablaEdge WiFi AP Credentials
# WARNING: Contains secrets — do not commit to git
AP_SSID="$SSID"
AP_PASSWORD="$PASSWORD"
EOF
    chmod 600 "$AP_ENV"

    whiptail --msgbox "WiFi AP credentials saved to:\n$AP_ENV" 10 50
}

show_network_status() {
    STATUS=$(nabla-net status 2>/dev/null || echo "nabla-net not installed or not running")
    whiptail --title "Network Status" --msgbox "$STATUS" 20 70
}

restart_network() {
    if whiptail --yesno "Restart networking services?\n\nThis may briefly disconnect SSH sessions." 10 50; then
        sudo systemctl restart nabla-net 2>/dev/null || \
            whiptail --msgbox "nabla-net service not found.\nManual restart required." 8 50
    fi
}

# ============================================================================
# MEDIOS (MEDIA) MENU
# ============================================================================

media_menu() {
    while true; do
        CHOICE=$(whiptail --title "Medios — Audio/Video" --menu "Configure media output" 14 60 6 \
            "Audio" "Select audio output device" \
            "Video" "Select video output" \
            "Volver" "Return to main menu" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "Audio") configure_audio ;;
            "Video") configure_video ;;
            "Volver") break ;;
        esac
    done
}

configure_audio() {
    AUDIO=$(whiptail --title "Audio Output" --radiolist "Select audio output:" 12 50 3 \
        "hdmi" "HDMI audio" ON \
        "headphones" "3.5mm headphone jack" OFF \
        "usb" "USB audio device" OFF \
        3>&1 1>&2 2>&3) || return

    # Apply via raspi-config or amixer
    whiptail --msgbox "Audio output set to: $AUDIO\n\n(Implementation depends on Pi model)" 10 50
}

configure_video() {
    VIDEO=$(whiptail --title "Video Output" --radiolist "Select video output:" 12 50 3 \
        "hdmi" "HDMI display" ON \
        "composite" "Composite video" OFF \
        "none" "Headless (no display)" OFF \
        3>&1 1>&2 2>&3) || return

    whiptail --msgbox "Video output set to: $VIDEO" 8 50
}

# ============================================================================
# ACCESORIOS (ACCESSORIES) MENU
# ============================================================================

accessories_menu() {
    load_accessories
    while true; do
        CHOICE=$(whiptail --title "Accesorios — Hardware" --menu "Configure attached hardware" 16 60 8 \
            "OLED" "Toggle OLED display (SSD1306 I2C) [$([[ $display_oled -eq 1 ]] && echo ON || echo OFF)]" \
            "Rotary" "Toggle rotary encoder [$([[ $rotary -eq 1 ]] && echo ON || echo OFF)]" \
            "TFT" "Toggle large SPI display [$([[ $display_large -eq 1 ]] && echo ON || echo OFF)]" \
            "Ver" "Show current configuration" \
            "Guardar" "Save and apply changes" \
            "Volver" "Return to main menu" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "OLED") toggle_oled ;;
            "Rotary") toggle_rotary ;;
            "TFT") toggle_display_large ;;
            "Ver") show_accessories ;;
            "Guardar") save_and_apply_accessories ;;
            "Volver") break ;;
        esac
    done
}

toggle_oled() {
    if [[ $display_oled -eq 1 ]]; then
        display_oled=0
        whiptail --msgbox "OLED display DISABLED\n\nSave to apply." 8 40
    else
        display_oled=1
        whiptail --msgbox "OLED display ENABLED\n\nI2C pins: SDA=GPIO2, SCL=GPIO3\nAddress: 0x3C\n\nSave to apply." 12 50
    fi
}

toggle_rotary() {
    if [[ $rotary -eq 1 ]]; then
        rotary=0
        whiptail --msgbox "Rotary encoder DISABLED\n\nSave to apply." 8 40
    else
        rotary=1
        whiptail --msgbox "Rotary encoder ENABLED\n\nPins: CLK=GPIO17, DT=GPIO27, SW=GPIO22\n\nSave to apply." 12 50
    fi
}

toggle_display_large() {
    if [[ $display_large -eq 1 ]]; then
        display_large=0
        whiptail --msgbox "Large SPI display DISABLED\n\nSave to apply." 8 40
    else
        display_large=1
        whiptail --msgbox "Large SPI display ENABLED\n\nSPI0: MOSI=GPIO10, SCLK=GPIO11, CE0=GPIO8\nDC=GPIO24, RST=GPIO25\n\nSave to apply." 12 55
    fi
}

show_accessories() {
    MSG="Current accessories configuration:\n\n"
    MSG+="display_oled=$display_oled\n"
    MSG+="rotary=$rotary\n"
    MSG+="display_large=$display_large\n"
    MSG+="\nConfig file: $ACCESSORIES_CONF"
    whiptail --title "Accessories Configuration" --msgbox "$MSG" 14 50
}

save_and_apply_accessories() {
    ensure_config_dir
    save_accessories
    
    # Restart relevant services
    sudo systemctl restart nabla-oled 2>/dev/null || true
    
    whiptail --msgbox "Accessories configuration saved and services restarted." 8 50
}

# ============================================================================
# CÁMARA (CAMERA) MENU
# ============================================================================

camera_menu() {
    while true; do
        CHOICE=$(whiptail --title "Cámara — Camera Module" --menu "Configure camera" 14 60 6 \
            "Enable" "Enable camera module" \
            "Test" "Capture test image" \
            "Stream" "Configure streaming (go2rtc)" \
            "Volver" "Return to main menu" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "Enable") enable_camera ;;
            "Test") test_camera ;;
            "Stream") configure_stream ;;
            "Volver") break ;;
        esac
    done
}

enable_camera() {
    if whiptail --yesno "Enable camera module?\n\nThis may require a reboot." 10 50; then
        sudo raspi-config nonint do_camera 0 2>/dev/null || \
            whiptail --msgbox "Camera configuration requires raspi-config." 8 50
    fi
}

test_camera() {
    TEST_IMG="/tmp/nabla-camera-test.jpg"
    if libcamera-still -o "$TEST_IMG" --timeout 2000 2>/dev/null; then
        whiptail --msgbox "Test image captured:\n$TEST_IMG" 8 50
    else
        whiptail --msgbox "Camera test failed.\n\nEnsure camera is enabled and connected." 10 50
    fi
}

configure_stream() {
    whiptail --msgbox "Streaming configuration:\n\ngo2rtc is used for camera streaming.\nConfig: /etc/go2rtc.yaml\n\nSee voice-satellite docs for HA integration." 12 55
}

# ============================================================================
# VOZ (VOICE) MENU
# ============================================================================

voice_menu() {
    while true; do
        CHOICE=$(whiptail --title "Voz — Voice Satellite" --menu "Configure HA Assist satellite" 14 60 6 \
            "Enable" "Enable voice satellite mode" \
            "WakeWord" "Configure wake word" \
            "Test" "Test microphone" \
            "Volver" "Return to main menu" \
            3>&1 1>&2 2>&3) || break

        case "$CHOICE" in
            "Enable") enable_voice_satellite ;;
            "WakeWord") configure_wakeword ;;
            "Test") test_microphone ;;
            "Volver") break ;;
        esac
    done
}

enable_voice_satellite() {
    whiptail --msgbox "Voice satellite enables this Pi as a\nHome Assistant Assist endpoint.\n\nRequires:\n- USB microphone\n- Speaker (3.5mm or USB)\n- Wyoming satellite service\n\nConfiguration in /etc/wyoming-satellite/" 14 55
}

configure_wakeword() {
    WAKEWORD=$(whiptail --inputbox "Wake word phrase:" 8 50 "hey jarvis" 3>&1 1>&2 2>&3) || return
    whiptail --msgbox "Wake word set to: $WAKEWORD\n\nNote: Requires openWakeWord model for custom phrases." 10 50
}

test_microphone() {
    whiptail --msgbox "Testing microphone...\n\nSpeak now. Recording for 3 seconds." 8 50
    arecord -d 3 -f cd /tmp/mic-test.wav 2>/dev/null && \
        aplay /tmp/mic-test.wav 2>/dev/null || \
        whiptail --msgbox "Microphone test failed.\n\nCheck ALSA configuration." 8 50
}

# ============================================================================
# INFO MENU
# ============================================================================

info_menu() {
    HOSTNAME=$(hostname)
    IP=$(hostname -I | awk '{print $1}')
    KERNEL=$(uname -r)
    UPTIME=$(uptime -p)
    TEMP=$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2 || echo "N/A")
    
    MSG="NablaEdge System Information\n\n"
    MSG+="Hostname: $HOSTNAME\n"
    MSG+="IP Address: $IP\n"
    MSG+="Kernel: $KERNEL\n"
    MSG+="Uptime: $UPTIME\n"
    MSG+="CPU Temp: $TEMP\n"
    MSG+="\nnabla-config version: $VERSION"
    
    whiptail --title "System Info" --msgbox "$MSG" 16 55
}

# ============================================================================
# USB HOTPLUG DIALOG
# ============================================================================

usb_hotplug_dialog() {
    DEVICE="$1"
    
    if [[ -z "$DEVICE" ]]; then
        echo "Usage: nabla-config --usb-dialog /dev/sdX"
        exit 1
    fi
    
    # Check if this is a protected/labeled drive (skip dialog)
    LABEL=$(lsblk -no LABEL "$DEVICE" 2>/dev/null | head -1)
    if [[ "$LABEL" == "NABLA-DATA"* ]] || [[ "$LABEL" == "PROTECTED"* ]]; then
        echo "Protected drive detected ($LABEL), skipping dialog."
        exit 0
    fi
    
    CHOICE=$(whiptail --title "USB Drive Detected" --menu "Drive: $DEVICE" 14 60 4 \
        "WriteOS" "Write NablaEdge image to drive" \
        "OTP" "Enable USB boot (Pi 3B OTP)" \
        "Open" "Mount and browse files" \
        "Nothing" "Ignore this drive" \
        3>&1 1>&2 2>&3) || exit 0

    case "$CHOICE" in
        "WriteOS")
            if whiptail --yesno "WARNING: This will ERASE all data on $DEVICE\n\nContinue?" 10 50; then
                nabla-image --target "$DEVICE"
            fi
            ;;
        "OTP")
            whiptail --msgbox "OTP USB boot enabler\n\nThis permanently enables USB boot on Pi 3B.\nRun on a booted Pi, not from this menu.\n\nSee: nabla-image --enable-otp" 12 55
            ;;
        "Open")
            MOUNT_POINT="/mnt/usb-$(basename "$DEVICE")"
            sudo mkdir -p "$MOUNT_POINT"
            sudo mount "$DEVICE"1 "$MOUNT_POINT" 2>/dev/null && \
                whiptail --msgbox "Mounted at: $MOUNT_POINT" 8 50 || \
                whiptail --msgbox "Mount failed. Try mounting manually." 8 50
            ;;
        "Nothing")
            exit 0
            ;;
    esac
}

# ============================================================================
# COMMAND LINE INTERFACE
# ============================================================================

show_help() {
    cat << EOF
nabla-config v$VERSION — NablaEdge Configuration Panel

USAGE:
    nabla-config [OPTIONS]

OPTIONS:
    -h, --help          Show this help message
    -v, --version       Show version
    --network           Jump to network menu
    --accessories       Jump to accessories menu
    --media             Jump to media menu
    --camera            Jump to camera menu
    --voice             Jump to voice menu
    --status            Print current configuration (non-interactive)
    --usb-dialog DEV    Show USB hotplug dialog for device

CONFIGURATION FILES:
    $ACCESSORIES_CONF   Accessories flags (display_oled, rotary, etc.)
    $NETWORK_CONF       Network mode (cable, ap, cable-ap, off)
    $AP_ENV             WiFi AP credentials (user-specific)

EXAMPLES:
    sudo nabla-config                  # Interactive menu
    sudo nabla-config --accessories    # Jump to accessories
    nabla-config --status              # Show current config

SEE ALSO:
    nabla-net(1), nabla-image(1)
    https://github.com/txemavs/nabla-edge/tree/main/nablaedge/docs
EOF
}

show_status() {
    echo "nabla-config v$VERSION — Current Configuration"
    echo "=============================================="
    echo
    echo "Accessories ($ACCESSORIES_CONF):"
    if [[ -f "$ACCESSORIES_CONF" ]]; then
        cat "$ACCESSORIES_CONF" | grep -v '^#' | grep -v '^$'
    else
        echo "  (not configured)"
    fi
    echo
    echo "Network ($NETWORK_CONF):"
    if [[ -f "$NETWORK_CONF" ]]; then
        cat "$NETWORK_CONF" | grep -v '^#' | grep -v '^$'
    else
        echo "  (not configured)"
    fi
}

# ============================================================================
# MAIN ENTRY POINT
# ============================================================================

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    -v|--version)
        echo "nabla-config v$VERSION"
        ;;
    --network)
        network_menu
        ;;
    --accessories)
        accessories_menu
        ;;
    --media)
        media_menu
        ;;
    --camera)
        camera_menu
        ;;
    --voice)
        voice_menu
        ;;
    --status)
        show_status
        ;;
    --usb-dialog)
        usb_hotplug_dialog "$2"
        ;;
    "")
        main_menu
        ;;
    *)
        echo "Unknown option: $1"
        echo "Try: nabla-config --help"
        exit 1
        ;;
esac

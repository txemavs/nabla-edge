#!/bin/bash
# nabla-config — Nabla Edge ncurses panel (network + USB/SD media)
# Usage: sudo nabla-config
set -euo pipefail

VERSION="0.8.0"
OWNER="${SUDO_USER:-$USER}"
REAL_HOME="$(getent passwd "$OWNER" | cut -d: -f6)"
REAL_HOME="${REAL_HOME:-$HOME}"
VPN_BIN="$(command -v vpn-mode 2>/dev/null || true)"
[ -x "$VPN_BIN" ] || VPN_BIN="$REAL_HOME/bin/vpn-mode"
[ -x "$VPN_BIN" ] || VPN_BIN="/usr/local/bin/vpn-mode"
IMG_BIN="$(command -v nabla-image 2>/dev/null || true)"
[ -x "$IMG_BIN" ] || IMG_BIN="$REAL_HOME/bin/nabla-image"
[ -x "$IMG_BIN" ] || IMG_BIN="/usr/local/bin/nabla-image"
TITLE="Nabla Config $VERSION"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Requires root: sudo nabla-config $*" >&2
    exit 1
  fi
}

have_wt() { command -v whiptail >/dev/null 2>&1; }

msg() {
  local t="${1:-Nabla}"; shift
  if have_wt; then
    whiptail --title "$t" --msgbox "$*" 16 72
  else
    echo "==> $t"; echo "$*"; read -r -p "Enter..." _
  fi
}

ask_yes() {
  local t="$1" q="$2"
  if have_wt; then
    whiptail --title "$t" --yesno "$q" 12 72
  else
    read -r -p "$q [y/N] " a
    case "$a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  fi
}

ask_input() {
  local t="$1" q="$2" def="${3:-}"
  if have_wt; then
    whiptail --title "$t" --inputbox "$q" 10 72 "$def" 3>&1 1>&2 2>&3
  else
    read -r -p "$q [$def]: " a
    echo "${a:-$def}"
  fi
}

run_vpn() {
  need_root
  [ -x "$VPN_BIN" ] || { msg "Error" "Cannot find vpn-mode"; return 1; }
  "$VPN_BIN" "$@"
}

run_image() {
  need_root
  [ -x "$IMG_BIN" ] || { msg "Error" "Cannot find nabla-image"; return 1; }
  "$IMG_BIN" "$@"
}

# --- disk helpers ---
# Returns candidates as lines: NAME|SIZE|MODEL|LABEL|MOUNT|NOTE
list_candidate_disks() {
  local name size model tran typ root_disk label mnt note protected
  root_disk="$(lsblk -no PKNAME "$(findmnt -n -o SOURCE /)" 2>/dev/null || true)"

  # NAME SIZE TRAN TYPE only — MODEL has spaces and breaks `read`
  while read -r name size tran typ; do
    [ "$typ" = disk ] || continue
    case "$name" in
      loop*|zram*|ram*|dm-*) continue ;;
    esac
    if [ -n "$root_disk" ] && [ "$name" = "$root_disk" ]; then
      continue
    fi
    # skip the Pi's own boot SD/eMMC
    if [[ "$name" == mmcblk* ]]; then
      local boot_src boot_pk
      boot_src="$(findmnt -n -o SOURCE /boot/firmware 2>/dev/null || findmnt -n -o SOURCE /boot 2>/dev/null || true)"
      boot_pk="$(lsblk -no PKNAME "$boot_src" 2>/dev/null || true)"
      if [ "$name" = "$boot_pk" ] || [ "$name" = "$root_disk" ]; then
        continue
      fi
    fi

    model="$(lsblk -dn -o MODEL,VENDOR "/dev/$name" 2>/dev/null | sed 's/  */ /g;s/^ //;s/ $//')"
    model="${model:-?}"
    label="$(lsblk -ln -o LABEL "/dev/$name" 2>/dev/null | grep -v '^$' | tr '\n' ',' | sed 's/,$//')"
    mnt="$(lsblk -ln -o MOUNTPOINT "/dev/$name" 2>/dev/null | grep -v '^$' | tr '\n' ',' | sed 's/,$//')"
    note=""
    protected=0
    if echo "$mnt" | grep -q '/mnt/usbdata'; then
      note="PROTECTED usbdata"
      protected=1
    elif echo "$label" | grep -qi 'usbdata'; then
      note="PROTECTED label usbdata"
      protected=1
    elif [ -n "$mnt" ]; then
      note="mounted:$mnt"
    else
      note="available"
    fi
    # Prefer USB; also allow mmc (USB SD readers sometimes show as mmc)
    if [ "${tran:-}" = usb ] || [ "${tran:-}" = mmc ] || [ -z "${tran:-}" ]; then
      echo "${name}|${size}|${model}|${label:-—}|${mnt:-—}|${note}|${protected}"
    fi
  done < <(lsblk -dn -o NAME,SIZE,TRAN,TYPE 2>/dev/null)
}

pick_disk() {
  local purpose="$1"  # os | otp
  local lines=() tags=() i=0 line name size model label mnt note prot desc
  mapfile -t lines < <(list_candidate_disks)
  if [ "${#lines[@]}" -eq 0 ]; then
    msg "Media" "No USB/SD disk candidates found.\nPlug in a drive or card reader and try again.\n(System SD and usbdata are not listed.)"
    return 1
  fi

  if have_wt; then
    local args=()
    for line in "${lines[@]}"; do
      IFS='|' read -r name size model label mnt note prot <<<"$line"
      desc="${size} · ${model} · ${note}"
      [ "$label" != "—" ] && [ -n "$label" ] && desc="${desc} [${label}]"
      args+=("$name" "$desc")
    done
    name=$(whiptail --title "Select disk ($purpose)" --menu \
      "The selected disk will be ERASED.\nusbdata and system SD are not listed (or marked)." \
      20 78 10 "${args[@]}" 3>&1 1>&2 2>&3) || return 1
  else
    echo "Disks:"
    i=1
    for line in "${lines[@]}"; do
      IFS='|' read -r name size model label mnt note prot <<<"$line"
      echo "  $i) /dev/$name  $size  $model  $note"
      tags+=("$name|$prot")
      i=$((i+1))
    done
    read -r -p "> " n
    [[ "$n" =~ ^[0-9]+$ ]] || return 1
    IFS='|' read -r name prot <<<"${tags[$((n-1))]}"
  fi

  # resolve protected flag for chosen
  prot=0
  for line in "${lines[@]}"; do
    IFS='|' read -r n2 size model label mnt note p2 <<<"$line"
    if [ "$n2" = "$name" ]; then
      prot="$p2"
      size="$size"; model="$model"; note="$note"; label="$label"
      break
    fi
  done
  if [ "$prot" = "1" ]; then
    msg "Protected" "/dev/$name is protected ($note).\nCannot write here."
    return 1
  fi

  if ! ask_yes "Confirm erase" \
    "You are about to write ($purpose) to:\n\n  /dev/$name\n  $size · $model\n  $note\n\nALL data will be lost. Continue?"; then
    return 1
  fi
  # double confirm for large/desktop
  if ! ask_yes "Final confirmation" "CONFIRM: erase /dev/$name and write Nabla ($purpose)?"; then
    return 1
  fi

  # unmount all partitions
  local p
  for p in $(lsblk -ln -o NAME "/dev/$name" | tail -n +2); do
    umount -f "/dev/$p" 2>/dev/null || true
  done
  umount -f "/dev/$name" 2>/dev/null || true

  echo "/dev/$name"
}

menu_media() {
  while true; do
    local c=""
    if have_wt; then
      c=$(whiptail --title "$TITLE · Media" --menu "USB / SD (no Pi Imager)" 18 72 8 \
        "1" "Nabla Pi OS full (desktop) → USB/SD" \
        "2" "Nabla Pi OS lite → USB/SD" \
        "3" "OTP enabler (Pi 3B, once) → SD/USB" \
        "4" "List disks" \
        "5" "Download base image (cache)" \
        "6" "Back" \
        3>&1 1>&2 2>&3) || return 0
    else
      echo "1 OS desktop  2 OS lite  3 OTP  4 list  5 fetch  6 back"
      read -r -p "> " c
    fi
    case "$c" in
      1)
        local dev hn oct
        dev="$(pick_disk os)" || continue
        hn="$(ask_input "Hostname" "Name for the new Pi:" "edge")" || continue
        oct="$(ask_input "Octet" "Subnet 10.100.N.0/24 — N:" "3")" || continue
        msg "Writing" "Writing desktop to $dev…\nThis may take a while (download + dd).\nCheck terminal if SSH."
        clear 2>/dev/null || true
        if run_image write-usb "$dev" --desktop --hostname "$hn" --octeto "$oct"; then
          msg "OK" "Nabla Pi OS (desktop) on $dev.\nBoot the Pi: first-boot installs Edge."
        else
          msg "Error" "Write failed. Check terminal / logs."
        fi
        ;;
      2)
        local dev hn oct
        dev="$(pick_disk os)" || continue
        hn="$(ask_input "Hostname" "Name for the new Pi:" "edge")" || continue
        oct="$(ask_input "Octet" "Subnet 10.100.N.0/24 — N:" "3")" || continue
        clear 2>/dev/null || true
        if run_image write-usb "$dev" --lite --hostname "$hn" --octeto "$oct"; then
          msg "OK" "Nabla Pi OS (lite) on $dev."
        else
          msg "Error" "Write failed."
        fi
        ;;
      3)
        local dev
        dev="$(pick_disk otp)" || continue
        clear 2>/dev/null || true
        if run_image write-otp "$dev"; then
          msg "OK" "OTP enabler on $dev.\nBoot the 3B with this media ~1 min."
        else
          msg "Error" "write-otp failed."
        fi
        ;;
      4)
        local txt
        txt="$(list_candidate_disks | sed 's/|/ · /g')"
        [ -n "$txt" ] || txt="(none)"
        msg "Disks" "$txt"
        ;;
      5)
        clear 2>/dev/null || true
        run_image fetch-base desktop || run_image fetch-base lite
        msg "Cache" "Image in ~/.cache/nabla-image (if no error)."
        ;;
      6|"") return 0 ;;
    esac
  done
}

menu_network() {
  while true; do
    local c=""
    if have_wt; then
      c=$(whiptail --title "$TITLE · Network" --menu "Nabla Net / vpn-mode" 18 72 8 \
        "1" "Status" \
        "2" "CABLE (eth LAN + Tailscale)" \
        "3" "AP (SSID Nabla Net)" \
        "4" "CABLE-AP (eth + wlan1 AP)" \
        "5" "OFF" \
        "6" "Back" \
        3>&1 1>&2 2>&3) || return 0
    else
      echo "1 status 2 cable 3 ap 4 cable-ap 5 off 6 back"
      read -r -p "> " c
    fi
    case "$c" in
      1)
        local s
        s="$([ -x "$VPN_BIN" ] && "$VPN_BIN" status 2>&1 || echo 'vpn-mode not found')"
        msg "Network status" "Host: $(hostname)\n\n$s"
        ;;
      2) clear; run_vpn cable; msg "Network" "Mode: CABLE." ;;
      3) clear; run_vpn ap; msg "Network" "Mode: AP." ;;
      4) clear; run_vpn cable-ap; msg "Network" "Mode: CABLE-AP." ;;
      5) clear; run_vpn off; msg "Network" "OFF." ;;
      6|"") return 0 ;;
    esac
  done
}


ACC_CONF="/etc/nabla-net/accessories.conf"

acc_load() {
  display_oled=0; rotary=0; display_large=0
  if [ -f "$ACC_CONF" ]; then
    # shellcheck disable=SC1090
    . "$ACC_CONF"
  fi
  DISPLAY_OLED="${display_oled:-0}"
  ROTARY="${rotary:-0}"
  DISPLAY_LARGE="${display_large:-0}"
}

acc_save() {
  need_root
  install -d -m 755 /etc/nabla-net
  cat > "$ACC_CONF" <<EOF
# Nabla Edge accessories profile (managed by nabla-config)
# Consumed by installers / first-boot / GPIO helpers.
display_oled=${1}
rotary=${2}
display_large=${3}
EOF
  chmod 644 "$ACC_CONF"
}

acc_label() {
  case "$1" in
    1|on|yes|true) echo ON ;;
    *) echo OFF ;;
  esac
}

acc_toggle() {
  if [ "$1" = "1" ]; then echo 0; else echo 1; fi
}

acc_summary() {
  acc_load
  printf 'OLED I2C (small):  %s\n' "$(acc_label $DISPLAY_OLED)"
  printf 'Rotary encoder:    %s\n' "$(acc_label $ROTARY)"
  printf 'Large SPI display: %s\n' "$(acc_label $DISPLAY_LARGE)"
  printf '\nConfig: %s\n' "$ACC_CONF"
}

menu_accessories() {
  while true; do
    acc_load
    local c="" oled_l rot_l big_l
    oled_l=$(acc_label "$DISPLAY_OLED")
    rot_l=$(acc_label "$ROTARY")
    big_l=$(acc_label "$DISPLAY_LARGE")
    if have_wt; then
      c=$(whiptail --title "$TITLE · Accessories" --menu \
        "Hardware profile for this Pi / image.\nMark what is (or will be) attached." 20 74 10 \
        "1" "Small I2C OLED display     [$oled_l]" \
        "2" "Rotary encoder (EC11)      [$rot_l]" \
        "3" "Large SPI display          [$big_l]" \
        "4" "Apply OLED now (if ON)" \
        "5" "View profile" \
        "6" "Back" \
        3>&1 1>&2 2>&3) || return 0
    else
      echo "Accessories: 1 OLED[$oled_l] 2 rotary[$rot_l] 3 large[$big_l] 4 apply-oled 5 show 6 back"
      read -r -p "> " c
    fi
    case "$c" in
      1)
        DISPLAY_OLED=$(acc_toggle "$DISPLAY_OLED")
        acc_save "$DISPLAY_OLED" "$ROTARY" "$DISPLAY_LARGE"
        if [ "$DISPLAY_OLED" = "1" ]; then
          msg "Accessories" "OLED I2C: ON\nTypical pins: SDA=GPIO2 SCL=GPIO3 VCC 3.3V GND"
        else
          msg "Accessories" "OLED I2C: OFF"
        fi
        ;;
      2)
        ROTARY=$(acc_toggle "$ROTARY")
        acc_save "$DISPLAY_OLED" "$ROTARY" "$DISPLAY_LARGE"
        if [ "$ROTARY" = "1" ]; then
          msg "Accessories" "Rotary encoder: ON\n\nEC11 wiring (BCM GPIO):\n  CLK (A) = GPIO17 (pin 11)\n  DT  (B) = GPIO27 (pin 13)\n  SW      = GPIO22 (pin 15)\n  GND     = any GND pin\n  3V3     = optional (pin 1)\n\nInternal pull-ups enabled in software."
        else
          msg "Accessories" "Rotary encoder: OFF"
        fi
        ;;
      3)
        DISPLAY_LARGE=$(acc_toggle "$DISPLAY_LARGE")
        acc_save "$DISPLAY_OLED" "$ROTARY" "$DISPLAY_LARGE"
        if [ "$DISPLAY_LARGE" = "1" ]; then
          msg "Accessories" "Large SPI display: ON\nSPI TFT profile (kiosk). Driver/pins: see Edge docs."
        else
          msg "Accessories" "Large SPI display: OFF"
        fi
        ;;
      4)
        if [ "${DISPLAY_OLED:-0}" != "1" ]; then
          if ask_yes "OLED" "Profile has OLED=OFF. Enable and apply service?"; then
            DISPLAY_OLED=1
            acc_save "$DISPLAY_OLED" "$ROTARY" "$DISPLAY_LARGE"
          else
            continue
          fi
        fi
        enable_oled
        ;;
      5)
        msg "Accessories profile" "$(acc_summary)"
        ;;
      6|"") return 0 ;;
    esac
  done
}


enable_camera() {
  need_root
  local nn
  nn="$(command -v nabla-net 2>/dev/null || true)"
  [ -x "$nn" ] || nn="$REAL_HOME/bin/nabla-net"
  if [ -x "$nn" ]; then
    "$nn" camera
  else
    msg "Camera" "Install nabla-net / Edge for go2rtc."
  fi
}


enable_oled() {
  need_root
  local en
  en="$(command -v nabla-oled-enable 2>/dev/null || true)"
  [ -x "$en" ] || en="$REAL_HOME/bin/nabla-oled-enable"
  [ -x "$en" ] || en="/usr/local/bin/nabla-oled-enable"
  if [ ! -x "$en" ]; then
    msg "OLED" "Cannot find nabla-oled-enable.\nReinstall Nabla Edge."
    return 1
  fi
  if ! ask_yes "OLED I2C" "Enable I2C OLED (SSD1306)?\n\nPins: VCC 3.3V, GND, SDA=GPIO2, SCL=GPIO3\nShows: nabla.net + time\n\nMay require reboot if I2C was not active."; then
    return 0
  fi
  clear 2>/dev/null || true
  if "$en"; then
    msg "OLED" "nabla-oled service enabled.\nIf nothing shows: check wires and reboot if I2C was requested."
  else
    msg "OLED" "Activation failed. Check terminal."
  fi
}

oled_status() {
  if systemctl is-active nabla-oled.service >/dev/null 2>&1; then
    echo "OLED: active"
  else
    echo "OLED: inactive"
  fi
}

# --- Voice satellite helpers (Linux Voice Assistant) ---
VOICE_CONF="/etc/nabla-edge/voice.conf"
VOICE_INSTALLER="/opt/nabla-edge/voice/install-lva.sh"
LVA_DIR="/opt/nabla-edge/voice/lva"

voice_load() {
  VOICE_MODE="button"
  VOICE_NAME="$(hostname -s 2>/dev/null || echo edge)"
  VOICE_PORT=6053
  VOICE_GPIO=17
  VOICE_WAKE_WORD="hey_jarvis"
  if [ -f "$VOICE_CONF" ]; then
    # shellcheck disable=SC1090
    . "$VOICE_CONF"
    VOICE_MODE="${MODE:-button}"
    VOICE_NAME="${SATELLITE_NAME:-$VOICE_NAME}"
    VOICE_PORT="${PORT:-6053}"
    VOICE_GPIO="${GPIO_PIN:-17}"
    VOICE_WAKE_WORD="${WAKE_WORD:-hey_jarvis}"
  fi
}

voice_save() {
  need_root
  install -d -m 755 /etc/nabla-edge
  cat > "$VOICE_CONF" <<EOF
# Nabla Edge Voice Satellite Configuration (Linux Voice Assistant)
# Managed by nabla-config

MODE=$VOICE_MODE
SATELLITE_NAME=$VOICE_NAME
GPIO_PIN=$VOICE_GPIO
WAKE_WORD=$VOICE_WAKE_WORD
PORT=$VOICE_PORT
EOF
  chmod 644 "$VOICE_CONF"
}

voice_status() {
  local lva_running=""
  
  # Check Docker container
  if command -v docker &>/dev/null; then
    if docker ps --format '{{.Names}}' 2>/dev/null | grep -q 'linux-voice-assistant'; then
      lva_running="running (Docker)"
    elif docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q 'linux-voice-assistant'; then
      lva_running="stopped (Docker)"
    fi
  fi
  
  # Check systemd service
  if [ -z "$lva_running" ]; then
    if systemctl is-active linux-voice-assistant.service >/dev/null 2>&1; then
      lva_running="running (systemd)"
    elif systemctl list-unit-files linux-voice-assistant.service >/dev/null 2>&1; then
      lva_running="stopped (systemd)"
    else
      lva_running="not installed"
    fi
  fi
  
  voice_load
  local mode_label
  case "$VOICE_MODE" in
    button) mode_label="HA start_conversation (primary)" ;;
    wake) mode_label="Local wake word" ;;
    *) mode_label="$VOICE_MODE" ;;
  esac
  
  printf 'Mode:            %s\n' "$mode_label"
  printf 'Name:            %s\n' "$VOICE_NAME"
  printf 'ESPHome port:    %s\n' "$VOICE_PORT"
  printf 'Wake word:       %s\n' "$VOICE_WAKE_WORD"
  printf 'LVA status:      %s\n' "$lva_running"
  if [ "$VOICE_MODE" = "button" ]; then
    printf 'GPIO button:     %s (optional)\n' "$VOICE_GPIO"
  fi
  printf '\nConfig: %s\n' "$VOICE_CONF"
}

voice_install() {
  need_root
  
  # Check for Docker
  if ! command -v docker &>/dev/null; then
    msg "Voice" "Docker is required for Linux Voice Assistant.\n\nInstall Docker first:\n  curl -fsSL https://get.docker.com | sh\n  sudo usermod -aG docker $OWNER"
    return 1
  fi
  
  voice_load
  
  if ! ask_yes "Install LVA" \
    "Install Linux Voice Assistant (LVA) for Home Assistant.\n\nLVA uses ESPHome protocol (port 6053).\nHA adds it via ESPHome integration.\nSupports: announce, start_conversation, wake words.\n\nName: $VOICE_NAME\nWake word: $VOICE_WAKE_WORD\n\nContinue?"; then
    return 0
  fi
  
  clear 2>/dev/null || true
  
  # Create LVA directory
  mkdir -p "$LVA_DIR"
  cd "$LVA_DIR"
  
  # Download latest docker-compose and .env
  local lva_version
  lva_version=$(curl -s https://api.github.com/repos/OHF-Voice/linux-voice-assistant/releases/latest | grep -oP '"tag_name": "\K[^"]+' || echo "latest")
  
  echo "Downloading LVA $lva_version..."
  curl -fsSL "https://raw.githubusercontent.com/OHF-Voice/linux-voice-assistant/refs/tags/$lva_version/docker-compose.yml" -o docker-compose.yml || \
    curl -fsSL "https://raw.githubusercontent.com/OHF-Voice/linux-voice-assistant/main/docker-compose.yml" -o docker-compose.yml
  
  curl -fsSL "https://raw.githubusercontent.com/OHF-Voice/linux-voice-assistant/refs/tags/$lva_version/.env.example" -o .env.example || \
    curl -fsSL "https://raw.githubusercontent.com/OHF-Voice/linux-voice-assistant/main/.env.example" -o .env.example
  
  # Create .env with our settings
  cat > .env <<EOF
# Linux Voice Assistant configuration
# Generated by nabla-config

LVA_NAME=$VOICE_NAME
LVA_WAKE_WORD=$VOICE_WAKE_WORD
LVA_PORT=$VOICE_PORT

# Audio (auto-detected, or set explicitly)
# LVA_AUDIO_DEVICE=default
# LVA_SPEAKER_DEVICE=default
EOF
  
  # Pull and start
  echo "Pulling LVA Docker image..."
  docker compose pull
  
  echo "Starting LVA..."
  docker compose up -d
  
  voice_save
  
  msg "Voice" "Linux Voice Assistant installed!\n\nNext steps:\n1. In HA: Add ESPHome integration\n   Host: $(hostname -I | awk '{print $1}')\n   Port: $VOICE_PORT\n\n2. Entity: assist_satellite.$VOICE_NAME\n   supports start_conversation + announce\n\n3. Add dashboard button to trigger\n   assist_satellite.start_conversation\n\nSee option 9 for details."
}

voice_start() {
  need_root
  
  if [ -d "$LVA_DIR" ] && [ -f "$LVA_DIR/docker-compose.yml" ]; then
    cd "$LVA_DIR"
    docker compose up -d
    msg "Voice" "LVA started.\n\nCheck: docker compose logs -f"
  else
    msg "Voice" "LVA not installed.\nUse option 1 to install."
  fi
}

voice_stop() {
  need_root
  
  if [ -d "$LVA_DIR" ] && [ -f "$LVA_DIR/docker-compose.yml" ]; then
    cd "$LVA_DIR"
    docker compose down
    msg "Voice" "LVA stopped."
  else
    msg "Voice" "LVA not installed."
  fi
}

voice_ha_instructions() {
  voice_load
  local ip_hint
  ip_hint="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [ -z "$ip_hint" ] && ip_hint="<this-Pi-IP>"
  
  msg "HA Setup (1/2)" "STEP 1: Add via ESPHome integration\n\n1. Settings → Devices & Services\n2. Add Integration → ESPHome\n3. Host: $ip_hint\n   Port: $VOICE_PORT\n\nEntity created:\n  assist_satellite.${VOICE_NAME}_satellite_assist\n  supported_features: 3 (announce + start_conversation)\n\nHA prerequisites:\n• Whisper add-on (STT)\n• Piper add-on (TTS)\n• Assist pipeline configured"
  
  msg "HA Setup (2/2)" "STEP 2: Dashboard 'Listen' button\n\nAdd a button that calls start_conversation:\n\ntype: button\nname: Listen\nicon: mdi:microphone\ntap_action:\n  action: call-service\n  service: assist_satellite.start_conversation\n  target:\n    entity_id: assist_satellite.${VOICE_NAME}_satellite_assist\n  data:\n    start_message: \"\" # optional greeting\n\nNow tap button → Pi listens!"
}

menu_voice() {
  while true; do
    voice_load
    local c="" mode_l wake_status
    case "$VOICE_MODE" in
      button) mode_l="Button / remote start (default)" ;;
      wake) mode_l="Wake word (continuous)" ;;
      *) mode_l="$VOICE_MODE" ;;
    esac
    
    # Wake word status for menu display
    if [ "$VOICE_MODE" = "wake" ]; then
      wake_status="ON: $VOICE_WAKE_WORD"
    else
      wake_status="OFF (button mode)"
    fi
    
    if have_wt; then
      c=$(whiptail --title "$TITLE · Voice Satellite" --menu \
        "Linux Voice Assistant for Home Assistant.\n\nTrigger modes:\n  • Button (default): HA start_conversation from phone/dashboard\n  • Wake word: Continuous listening (optional, uses more CPU)" 26 78 14 \
        "1" "Install / update LVA (Docker)" \
        "2" "──────── Configuration ────────" \
        "3" "Satellite name: $VOICE_NAME" \
        "4" "ESPHome port: $VOICE_PORT" \
        "5" "──────── Trigger Mode ────────" \
        "6" "Mode: $mode_l" \
        "7" "Wake word: $wake_status" \
        "8" "Wake word (custom) — Coming soon" \
        "9" "──────── Control ────────" \
        "10" "Start LVA" \
        "11" "Stop LVA" \
        "12" "View status" \
        "13" "HA Setup Instructions" \
        "14" "Back" \
        3>&1 1>&2 2>&3) || return 0
    else
      echo "Voice: 1 install 3 name[$VOICE_NAME] 4 port[$VOICE_PORT] 6 mode[$mode_l] 7 wake[$wake_status] 10 start 11 stop 12 status 13 HA-help 14 back"
      read -r -p "> " c
    fi
    
    case "$c" in
      1) voice_install ;;
      2|5|9) continue ;;  # Separator lines
      3)
        local new_name
        new_name="$(ask_input "Name" "Satellite name (appears in HA):" "$VOICE_NAME")" || continue
        [ -n "$new_name" ] && VOICE_NAME="$new_name"
        voice_save
        msg "Voice" "Name: $VOICE_NAME\n\nRestart LVA for changes to take effect."
        ;;
      4)
        local new_port
        new_port="$(ask_input "Port" "ESPHome port (default 6053):" "$VOICE_PORT")" || continue
        [[ "$new_port" =~ ^[0-9]+$ ]] && VOICE_PORT="$new_port"
        voice_save
        msg "Voice" "Port: $VOICE_PORT\n\nRestart LVA for changes to take effect."
        ;;
      6)
        if [ "$VOICE_MODE" = "button" ]; then
          VOICE_MODE="wake"
          voice_save
          msg "Voice" "Mode: Wake word (continuous listening).\n\nLVA listens for '$VOICE_WAKE_WORD'.\nNote: uses more CPU than button mode.\n\nHA start_conversation still works too."
        else
          VOICE_MODE="button"
          voice_save
          msg "Voice" "Mode: Button / remote start (default).\n\nPrimary trigger: HA start_conversation\nCall from phone dashboard button or GPIO.\nWake word disabled to save CPU."
        fi
        ;;
      7)
        if [ "$VOICE_MODE" != "wake" ]; then
          msg "Voice" "Wake word is only active in 'wake' mode.\n\nCurrent mode: button (default)\n\nChange mode first via option 6 to enable\ncontinuous wake word listening."
          continue
        fi
        local new_wake
        new_wake="$(ask_input "Wake word" "Available: hey_jarvis, ok_nabu, alexa, hey_mycroft" "$VOICE_WAKE_WORD")" || continue
        [ -n "$new_wake" ] && VOICE_WAKE_WORD="$new_wake"
        voice_save
        msg "Voice" "Wake word: $VOICE_WAKE_WORD\n\nRestart LVA for changes to take effect."
        ;;
      8)
        msg "Custom Wake Word" "Coming soon: Custom wake word support.\n\nPlanned:\n  • Oye Veronica (microWakeWord, training)\n  • Custom .tflite model upload\n\nCurrently training on RTX 4090.\nOnce ready, model files go to:\n  /opt/nabla-edge/voice/wake/\n\nFor now, use built-in wake words:\n  hey_jarvis, ok_nabu, alexa, hey_mycroft"
        ;;
      10) voice_start ;;
      11) voice_stop ;;
      12) msg "Voice satellite status" "$(voice_status)" ;;
      13) voice_ha_instructions ;;
      14|"") return 0 ;;
    esac
  done
}

cmd_info() {
  msg "Info" "Nabla Config $VERSION\n\n• Network: cable / AP / cable-ap / off\n• Media: Nabla Pi OS or OTP\n• USB hotplug: dialog (OS / OTP / open)\n• Accessories: OLED / rotary / SPI\n• Camera / voice\n\nRepo: coco.nabla.net/packages"
}

menu() {
  while true; do
    local c=""
    if have_wt; then
      c=$(whiptail --title "$TITLE" --menu "Nabla Edge Panel" 20 72 11 \
        "1" "Network" \
        "2" "Media (USB/SD)" \
        "3" "Accessories" \
        "4" "Camera" \
        "5" "Voice Satellite" \
        "6" "Info" \
        "7" "Exit" \
        3>&1 1>&2 2>&3) || return 0
    else
      echo "===== $TITLE ====="
      echo "1 Network  2 Media  3 Accessories  4 Camera  5 Voice  6 Info  7 Exit"
      read -r -p "> " c
    fi
    case "$c" in
      1) menu_network ;;
      2) menu_media ;;
      3) menu_accessories ;;
      4) enable_camera ;;
      5) menu_voice ;;
      6) cmd_info ;;
      7|"") return 0 ;;
    esac
  done
}

main() {
  case "${1:-}" in
    ""|menu) need_root; menu ;;
    -h|--help|help)
      cat <<'H'
NAME
    nabla-config — Nabla Edge configuration panel (whiptail)

SYNOPSIS
    sudo nabla-config
    sudo nabla-config network|media|accessories|oled|voice
    nabla-config --help

DESCRIPTION
    Interactive control panel for a Nabla Edge Raspberry Pi. It configures
    network modes (Nabla Net / vpn-mode), writes Nabla Pi OS or OTP media to
    USB/SD, and stores an accessories profile for optional hardware.

MENUS
    Network
        cable, ap, cable-ap, off, status — via vpn-mode / nabla-net.

    Media
        Download Raspberry Pi OS (cached), inject Nabla first-boot, write
        USB/SD; or write a one-shot OTP enabler for Pi 3B USB boot.

    Accessories
        Toggle and persist hardware intent under
        /etc/nabla-net/accessories.conf:
          display_oled=0|1     small I2C SSD1306 OLED
          rotary=0|1           EC11 rotary encoder
          display_large=0|1    large SPI TFT / kiosk panel
        "Apply OLED now" runs nabla-oled-enable when OLED is ON.

    Camera
        go2rtc USB camera helper.

    Voice Satellite
        Linux Voice Assistant (LVA) for Home Assistant Assist.
        Uses ESPHome protocol (port 6053) with full feature support:
          - assist_satellite.start_conversation (HA dashboard button)
          - assist_satellite.announce
          - Wake word detection (optional)
        Config: /etc/nabla-edge/voice.conf

FILES
    /etc/nabla-net/accessories.conf
        Accessories profile read by installers and helpers.
    /etc/nabla-edge/voice.conf
        Voice satellite configuration.
    /opt/nabla-edge/voice/lva/
        Linux Voice Assistant Docker Compose files.

EXIT STATUS
    0  success or user cancel from menu
    1  usage / missing tool / root required

SEE ALSO
    nabla-net, nabla-image, vpn-mode, AGENTS.md
H
      ;;
    media|image) need_root; menu_media ;;
    network|net) need_root; menu_network ;;
    accessories|acc) need_root; menu_accessories ;;
    oled) need_root; enable_oled ;;
    voice) need_root; menu_voice ;;
    *) echo "Usage: sudo nabla-config"; exit 1 ;;
  esac
}

main "$@"

#!/bin/bash
# nabla-net v0.5 — NablaEdge Network Mode Manager
# Manages network modes: cable | ap | cable-ap | off
#
# SANITIZED REFERENCE COPY — no private IPs or hostnames.
# Example subnet: 192.0.2.0/24 (RFC 5737 documentation range)

set -e

VERSION="0.5"
CONFIG_DIR="/etc/nabla-net"
NETWORK_CONF="$CONFIG_DIR/network.conf"
AP_ENV="$HOME/.config/nabla-net-ap.env"

# Documentation-safe example values (RFC 5737)
EXAMPLE_SUBNET="192.0.2.0/24"
EXAMPLE_GATEWAY="192.0.2.1"
EXAMPLE_DHCP_START="192.0.2.100"
EXAMPLE_DHCP_END="192.0.2.200"

# ============================================================================
# CONFIGURATION
# ============================================================================

load_config() {
    # Defaults
    NETWORK_MODE="cable"
    AP_SSID="NablaNet"
    AP_PASSWORD="CHANGE_ME"
    AP_CHANNEL="6"
    
    # Load saved config
    [[ -f "$NETWORK_CONF" ]] && source "$NETWORK_CONF"
    [[ -f "$AP_ENV" ]] && source "$AP_ENV"
}

save_config() {
    sudo mkdir -p "$CONFIG_DIR"
    sudo tee "$NETWORK_CONF" > /dev/null << EOF
# NablaEdge Network Configuration
# Generated by nabla-net v$VERSION
network_mode=$NETWORK_MODE
EOF
}

# ============================================================================
# NETWORK MODES
# ============================================================================

# MODE: cable
# WiFi client connects to upstream network
# Ethernet provides LAN for local devices
# NAT routes LAN traffic through WiFi uplink
apply_mode_cable() {
    echo "Applying mode: cable (WiFi uplink + Ethernet LAN + NAT)"
    
    # Stop AP services if running
    sudo systemctl stop hostapd 2>/dev/null || true
    sudo systemctl stop dnsmasq 2>/dev/null || true
    
    # Enable WiFi client
    sudo rfkill unblock wifi
    
    # Configure Ethernet as LAN (static IP for this node)
    # Actual IP configured in /etc/dhcpcd.conf or networkd
    
    # Enable IP forwarding and NAT
    sudo sysctl -w net.ipv4.ip_forward=1
    sudo iptables -t nat -A POSTROUTING -o wlan0 -j MASQUERADE
    sudo iptables -A FORWARD -i eth0 -o wlan0 -j ACCEPT
    sudo iptables -A FORWARD -i wlan0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT
    
    echo "Mode 'cable' applied."
    echo "  Uplink: wlan0 (WiFi client)"
    echo "  LAN: eth0 (Ethernet)"
    echo "  NAT: enabled"
}

# MODE: ap
# Ethernet connects to upstream network
# WiFi broadcasts access point for local devices
apply_mode_ap() {
    echo "Applying mode: ap (Ethernet uplink + WiFi AP)"
    
    load_config
    
    if [[ "$AP_PASSWORD" == "CHANGE_ME" ]]; then
        echo "ERROR: AP password not configured."
        echo "Run: nabla-config --network → WiFi"
        exit 1
    fi
    
    # Configure hostapd
    sudo tee /etc/hostapd/hostapd.conf > /dev/null << EOF
interface=wlan0
driver=nl80211
ssid=$AP_SSID
hw_mode=g
channel=$AP_CHANNEL
wmm_enabled=0
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_passphrase=$AP_PASSWORD
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF
    
    # Configure dnsmasq for DHCP
    sudo tee /etc/dnsmasq.d/nabla-ap.conf > /dev/null << EOF
interface=wlan0
dhcp-range=$EXAMPLE_DHCP_START,$EXAMPLE_DHCP_END,255.255.255.0,24h
EOF
    
    # Start services
    sudo systemctl unmask hostapd
    sudo systemctl start hostapd
    sudo systemctl start dnsmasq
    
    echo "Mode 'ap' applied."
    echo "  Uplink: eth0 (Ethernet)"
    echo "  AP: wlan0 (SSID: $AP_SSID)"
}

# MODE: cable-ap
# Ethernet provides LAN
# Second WiFi radio broadcasts AP on same subnet (bridged)
apply_mode_cable_ap() {
    echo "Applying mode: cable-ap (Ethernet LAN + second radio AP)"
    
    # Check for second WiFi interface
    if ! ip link show wlan1 &>/dev/null; then
        echo "WARNING: wlan1 not found. This mode requires a second WiFi adapter."
        echo "Falling back to single-radio bridged AP on wlan0."
    fi
    
    load_config
    
    # Create bridge
    sudo ip link add name br0 type bridge 2>/dev/null || true
    sudo ip link set eth0 master br0
    sudo ip link set wlan0 master br0 2>/dev/null || true
    sudo ip link set br0 up
    
    # Configure hostapd on bridge
    sudo tee /etc/hostapd/hostapd.conf > /dev/null << EOF
interface=wlan0
bridge=br0
driver=nl80211
ssid=$AP_SSID
hw_mode=g
channel=$AP_CHANNEL
wpa=2
wpa_passphrase=$AP_PASSWORD
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF
    
    sudo systemctl start hostapd
    
    echo "Mode 'cable-ap' applied."
    echo "  Bridge: br0 (eth0 + wlan0)"
    echo "  AP: $AP_SSID"
}

# MODE: off
# Disable all networking
apply_mode_off() {
    echo "Applying mode: off (networking disabled)"
    
    sudo systemctl stop hostapd 2>/dev/null || true
    sudo systemctl stop dnsmasq 2>/dev/null || true
    sudo systemctl stop wpa_supplicant 2>/dev/null || true
    sudo rfkill block wifi
    sudo ip link set eth0 down 2>/dev/null || true
    
    echo "Networking disabled."
}

# ============================================================================
# STATUS
# ============================================================================

show_status() {
    load_config
    
    echo "nabla-net v$VERSION — Network Status"
    echo "====================================="
    echo
    echo "Mode: $NETWORK_MODE"
    echo
    
    echo "Interfaces:"
    for iface in eth0 wlan0 wlan1 br0; do
        if ip link show "$iface" &>/dev/null; then
            STATE=$(ip link show "$iface" | grep -oP '(?<=state )\w+')
            IP=$(ip -4 addr show "$iface" 2>/dev/null | grep -oP '(?<=inet )\S+' | head -1)
            echo "  $iface: $STATE ${IP:-no IP}"
        fi
    done
    echo
    
    # Check services
    echo "Services:"
    for svc in hostapd dnsmasq wpa_supplicant; do
        STATUS=$(systemctl is-active "$svc" 2>/dev/null || echo "inactive")
        echo "  $svc: $STATUS"
    done
    echo
    
    # WiFi connection (if client mode)
    if iwgetid -r &>/dev/null; then
        SSID=$(iwgetid -r)
        echo "WiFi connected: $SSID"
    fi
    
    # AP info (if AP mode)
    if systemctl is-active hostapd &>/dev/null; then
        echo "AP active: $(grep '^ssid=' /etc/hostapd/hostapd.conf 2>/dev/null | cut -d= -f2)"
        CLIENTS=$(iw dev wlan0 station dump 2>/dev/null | grep -c Station || echo 0)
        echo "AP clients: $CLIENTS"
    fi
}

# ============================================================================
# CLI
# ============================================================================

show_help() {
    cat << EOF
nabla-net v$VERSION — NablaEdge Network Mode Manager

USAGE:
    nabla-net <command> [args]

COMMANDS:
    set-mode <mode>     Set network mode (cable|ap|cable-ap|off)
    status              Show current network status
    restart             Restart current mode

MODES:
    cable       WiFi uplink + Ethernet LAN + NAT
    ap          Ethernet uplink + WiFi AP
    cable-ap    Ethernet LAN + second radio AP (bridged)
    off         Networking disabled

CONFIGURATION:
    $NETWORK_CONF       Current mode
    $AP_ENV             WiFi AP credentials

EXAMPLES:
    sudo nabla-net set-mode ap      # Switch to AP mode
    nabla-net status                # Show current status

SEE ALSO:
    nabla-config(1) — Interactive configuration
EOF
}

case "${1:-status}" in
    set-mode)
        NETWORK_MODE="${2:-cable}"
        case "$NETWORK_MODE" in
            cable) apply_mode_cable ;;
            ap) apply_mode_ap ;;
            cable-ap) apply_mode_cable_ap ;;
            off) apply_mode_off ;;
            *)
                echo "Unknown mode: $NETWORK_MODE"
                echo "Valid modes: cable, ap, cable-ap, off"
                exit 1
                ;;
        esac
        save_config
        ;;
    status)
        show_status
        ;;
    restart)
        load_config
        echo "Restarting mode: $NETWORK_MODE"
        case "$NETWORK_MODE" in
            cable) apply_mode_cable ;;
            ap) apply_mode_ap ;;
            cable-ap) apply_mode_cable_ap ;;
            off) apply_mode_off ;;
        esac
        ;;
    -h|--help)
        show_help
        ;;
    -v|--version)
        echo "nabla-net v$VERSION"
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac

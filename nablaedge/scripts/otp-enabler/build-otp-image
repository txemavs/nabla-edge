#!/bin/bash
# build-otp-image — Create a tiny OTP enabler SD image for Pi 3B
# Builds a minimal bootable image (~50-100MB) with:
#   - GPU firmware (bootcode.bin, start.elf, fixup.dat)
#   - 64-bit kernel (kernel8.img) + DTBs from Pi OS Lite
#   - Custom initramfs with busybox for HDMI diagnostics
#   - config.txt with program_usb_boot_mode=1
#
# Usage: build-otp-image [--output FILE] [--cache-dir DIR]
set -euo pipefail

VERSION="1.0.0"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Defaults
OUTPUT="${OUTPUT:-otp-enabler.img}"
CACHE_DIR="${CACHE_DIR:-${HOME}/.cache/nabla-otp}"
IMAGE_SIZE_MB=128
FIRMWARE_BRANCH="stable"
FIRMWARE_BASE="https://github.com/raspberrypi/firmware/raw/${FIRMWARE_BRANCH}/boot"
PIOS_LITE_URL="https://downloads.raspberrypi.org/raspios_lite_arm64/images/"

# Busybox static ARM64 — we'll download or build
BUSYBOX_URL="https://busybox.net/downloads/binaries/1.35.0-x86_64-linux-musl/busybox"
BUSYBOX_ARM64_URL="https://busybox.net/downloads/binaries/1.35.0-aarch64-linux-musl/busybox"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Build a tiny OTP enabler SD card image for Raspberry Pi 3B.

OPTIONS:
    -o, --output FILE    Output image file (default: otp-enabler.img)
    -c, --cache-dir DIR  Cache directory (default: ~/.cache/nabla-otp)
    -s, --size MB        Image size in MB (default: 128)
    --from-pios FILE     Extract kernel/DTBs from existing Pi OS image
    --clean              Remove cached files before building
    -h, --help           Show this help

The image includes:
  - Pi 3B GPU firmware (bootcode.bin, start.elf, fixup.dat)
  - 64-bit kernel (kernel8.img) and device tree blobs
  - Minimal initramfs with busybox and diagnostic scripts
  - config.txt with program_usb_boot_mode=1 (burns OTP fuse)

After writing to SD and booting on a Pi 3B:
  1. HDMI shows diagnostic text (model, serial, USB status)
  2. Scans for Nabla OS on attached USB drives
  3. OTP fuse is programmed by firmware before/during boot
  4. System stays on screen ~2 minutes, then halts

EOF
    exit 0
}

log() { echo ">>> $*"; }
err() { echo "ERROR: $*" >&2; exit 1; }
warn() { echo "WARNING: $*" >&2; }

check_deps() {
    local missing=()
    for cmd in curl dd mkfs.vfat parted losetup file xz; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if [ ${#missing[@]} -gt 0 ]; then
        err "Missing required tools: ${missing[*]}"
    fi
    [ "$(id -u)" -eq 0 ] || err "Must run as root (for losetup/mount)"
}

download_file() {
    local url="$1" dest="$2"
    if [ -f "$dest" ]; then
        log "Using cached: $dest"
        return 0
    fi
    log "Downloading: $url"
    curl -fSL --progress-bar -o "$dest.tmp" "$url" || return 1
    mv "$dest.tmp" "$dest"
}

download_firmware() {
    local fw_dir="$CACHE_DIR/firmware"
    mkdir -p "$fw_dir"
    
    # Essential GPU firmware
    download_file "$FIRMWARE_BASE/bootcode.bin" "$fw_dir/bootcode.bin"
    download_file "$FIRMWARE_BASE/start.elf" "$fw_dir/start.elf"
    download_file "$FIRMWARE_BASE/fixup.dat" "$fw_dir/fixup.dat"
    
    # Optionally get smaller start_cd.elf (cut-down version, ~2MB vs 3MB)
    download_file "$FIRMWARE_BASE/start_cd.elf" "$fw_dir/start_cd.elf" || true
    download_file "$FIRMWARE_BASE/fixup_cd.dat" "$fw_dir/fixup_cd.dat" || true
}

download_kernel_dtbs() {
    local kern_dir="$CACHE_DIR/kernel"
    mkdir -p "$kern_dir"
    
    # kernel8.img (64-bit kernel for Pi 3)
    download_file "$FIRMWARE_BASE/kernel8.img" "$kern_dir/kernel8.img"
    
    # Device tree blobs for Pi 3B and 3B+
    download_file "$FIRMWARE_BASE/bcm2710-rpi-3-b.dtb" "$kern_dir/bcm2710-rpi-3-b.dtb"
    download_file "$FIRMWARE_BASE/bcm2710-rpi-3-b-plus.dtb" "$kern_dir/bcm2710-rpi-3-b-plus.dtb"
    
    # Also grab CM3 in case someone uses this on a compute module
    download_file "$FIRMWARE_BASE/bcm2710-rpi-cm3.dtb" "$kern_dir/bcm2710-rpi-cm3.dtb" || true
}

download_busybox() {
    local bb_dir="$CACHE_DIR/busybox"
    mkdir -p "$bb_dir"
    
    if [ -f "$bb_dir/busybox" ] && file "$bb_dir/busybox" | grep -q "aarch64"; then
        log "Using cached busybox (aarch64)"
        return 0
    fi
    
    log "Downloading busybox (aarch64 static)"
    download_file "$BUSYBOX_ARM64_URL" "$bb_dir/busybox"
    chmod +x "$bb_dir/busybox"
}

create_initramfs() {
    local work_dir="$CACHE_DIR/initramfs-work"
    local initramfs_cpio="$CACHE_DIR/initramfs.cpio"
    
    log "Building initramfs..."
    rm -rf "$work_dir"
    mkdir -p "$work_dir"/{bin,sbin,dev,proc,sys,mnt,tmp,etc,usr/bin,usr/sbin}
    
    # Copy busybox
    cp "$CACHE_DIR/busybox/busybox" "$work_dir/bin/busybox"
    chmod +x "$work_dir/bin/busybox"
    
    # Create busybox symlinks
    for cmd in sh ash cat echo ls mount umount mkdir rmdir sleep \
               grep sed awk cut head tail tr wc sort uniq \
               dmesg clear reboot poweroff halt \
               blkid lsblk findfs df du free \
               hexdump od strings \
               test [ true false; do
        ln -sf busybox "$work_dir/bin/$cmd"
    done
    
    # Device nodes
    mknod -m 622 "$work_dir/dev/console" c 5 1
    mknod -m 666 "$work_dir/dev/null" c 1 3
    mknod -m 666 "$work_dir/dev/zero" c 1 5
    mknod -m 666 "$work_dir/dev/tty" c 5 0
    mknod -m 666 "$work_dir/dev/tty0" c 4 0
    mknod -m 666 "$work_dir/dev/tty1" c 4 1
    mknod -m 666 "$work_dir/dev/random" c 1 8
    mknod -m 666 "$work_dir/dev/urandom" c 1 9
    
    # Create the init script
    cat > "$work_dir/init" <<'INIT_SCRIPT'
#!/bin/sh
# Nabla OTP Enabler init script
# This runs from initramfs on Pi 3B to display diagnostics and detect USB

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Mount virtual filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true

# Clear screen and set up console
clear 2>/dev/null || true
exec </dev/console >/dev/console 2>&1

# ANSI colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_header() {
    echo ""
    echo -e "${CYAN}${BOLD}    NABLA OTP ENABLER${NC}"
    echo -e "${CYAN}    Programming USB boot fuse (Pi 3B)${NC}"
    echo ""
    echo "    ─────────────────────────────────"
}

get_pi_info() {
    local model serial revision
    
    if [ -f /proc/device-tree/model ]; then
        model=$(cat /proc/device-tree/model | tr -d '\0')
    else
        model="Unknown"
    fi
    
    if [ -f /proc/cpuinfo ]; then
        serial=$(grep -i serial /proc/cpuinfo | cut -d: -f2 | tr -d ' ')
        revision=$(grep -i revision /proc/cpuinfo | cut -d: -f2 | tr -d ' ')
    fi
    
    echo ""
    echo -e "    ${BOLD}Hardware Information${NC}"
    echo "    Model:    $model"
    [ -n "$serial" ] && echo "    Serial:   $serial"
    [ -n "$revision" ] && echo "    Revision: $revision"
}

check_otp_status() {
    echo ""
    echo -e "    ${BOLD}OTP Status${NC}"
    
    echo -e "    ${GREEN}OK${NC} USB boot fuse programmed by GPU firmware"
    echo ""
    echo "    This Pi 3B will boot from USB after power-off."
    echo "    Verify with: vcgencmd otp_dump | grep 17:"
    echo "    Expected:    17:3020000a"
}

scan_usb_devices() {
    echo ""
    echo -e "    ${BOLD}USB Storage${NC}"
    
    # Wait for USB enumeration
    sleep 2
    
    local found_usb=0
    local found_nabla=0
    
    for dev in /sys/block/sd*; do
        [ -e "$dev" ] || continue
        found_usb=1
        
        local devname=$(basename "$dev")
        local size_sectors=$(cat "$dev/size" 2>/dev/null || echo 0)
        local size_gb=$((size_sectors * 512 / 1024 / 1024 / 1024))
        local model=$(cat "$dev/device/model" 2>/dev/null | tr -d '\n' || echo "unknown")
        
        echo "    /dev/$devname: ${size_gb}GB $model"
        
        for part in /dev/${devname}*[0-9]; do
            [ -b "$part" ] || continue
            
            local label=$(blkid -s LABEL -o value "$part" 2>/dev/null || true)
            local fstype=$(blkid -s TYPE -o value "$part" 2>/dev/null || true)
            
            if [ -n "$fstype" ]; then
                mkdir -p /mnt/check
                if mount -t "$fstype" -o ro "$part" /mnt/check 2>/dev/null; then
                    if [ -f /mnt/check/nabla-edge.tar.gz ] || \
                       [ -f /mnt/check/nabla-firstboot ] || \
                       [ -f /mnt/check/firstboot.d/04-install-packages.sh ] || \
                       [ -d /mnt/check/nabla ] || \
                       ls /mnt/check/nabla-*.tar.gz 2>/dev/null | grep -q .; then
                        echo -e "    ${GREEN}USB: Nabla OS detected on $part${NC}"
                        found_nabla=1
                    elif [ "$label" = "bootfs" ] || [ "$label" = "rootfs" ]; then
                        if [ -f /mnt/check/kernel8.img ] || [ -f /mnt/check/cmdline.txt ]; then
                            echo "    $part: Pi OS (no Nabla files)"
                        fi
                    fi
                    umount /mnt/check 2>/dev/null || true
                fi
            fi
        done
    done
    
    if [ "$found_usb" -eq 0 ]; then
        echo -e "    ${YELLOW}USB: no USB disk${NC}"
    elif [ "$found_nabla" -eq 0 ]; then
        echo -e "    ${YELLOW}USB: no Nabla OS found${NC}"
    fi
    
    return $found_nabla
}

print_instructions() {
    echo ""
    echo "    ─────────────────────────────────"
    echo ""
    echo -e "    ${BOLD}Next Steps${NC}"
    echo "    1. Wait for countdown to complete"
    echo "    2. Power off when finished"
    echo "    3. Remove this SD card"
    echo "    4. Insert Nabla OS USB drive"
    echo "    5. Power on to boot from USB"
    echo ""
}

countdown() {
    local secs=${1:-120}
    echo -e "    ${BOLD}System will halt in $secs seconds${NC}"
    echo "    Press Enter to halt now"
    
    while [ $secs -gt 0 ]; do
        printf "\r    Remaining: %3d seconds " $secs
        
        if read -t 1 -n 1 2>/dev/null; then
            echo ""
            break
        fi
        secs=$((secs - 1))
    done
    echo ""
}

main() {
    print_header
    get_pi_info
    check_otp_status
    scan_usb_devices
    print_instructions
    countdown 120
    
    echo ""
    echo -e "    ${GREEN}OTP programming complete${NC}"
    echo "    Power off when finished, then remove this SD to boot from USB."
    echo ""
    
    sync
    echo "    Halting..."
    sleep 2
    
    poweroff -f 2>/dev/null || reboot -f 2>/dev/null || {
        echo "    Power off manually"
        while true; do sleep 3600; done
    }
}

main
INIT_SCRIPT
    chmod +x "$work_dir/init"
    
    # Create the cpio archive
    log "Creating initramfs cpio archive..."
    (cd "$work_dir" && find . | cpio -o -H newc 2>/dev/null) > "$initramfs_cpio"
    
    # Compress with gzip
    gzip -9 -f "$initramfs_cpio"
    mv "$initramfs_cpio.gz" "$CACHE_DIR/initramfs8"
    
    log "initramfs created: $(du -h "$CACHE_DIR/initramfs8" | cut -f1)"
    
    # Cleanup
    rm -rf "$work_dir"
}

create_boot_files() {
    local boot_dir="$CACHE_DIR/boot"
    mkdir -p "$boot_dir"
    
    # config.txt — THE KEY: program_usb_boot_mode=1
    cat > "$boot_dir/config.txt" <<'CONFIG'
# Nabla OTP Enabler — Pi 3B USB boot fuse
# This file programs the OTP fuse at boot!

# CRITICAL: Burns OTP fuse to enable USB boot on Pi 3B
# This is permanent and cannot be undone (but is harmless)
program_usb_boot_mode=1

# 64-bit mode for kernel8.img
arm_64bit=1

# Load our initramfs
initramfs initramfs8 followkernel

# HDMI output (always on for diagnostics)
hdmi_force_hotplug=1
hdmi_group=2
hdmi_mode=82

# Enable UART for debugging (optional)
enable_uart=1

# Use cut-down GPU firmware to save space (if available)
# Uncomment if start_cd.elf is present:
# gpu_mem=16
# start_file=start_cd.elf
# fixup_file=fixup_cd.dat
CONFIG

    # cmdline.txt — console on HDMI
    cat > "$boot_dir/cmdline.txt" <<'CMDLINE'
console=tty0 loglevel=3 quiet
CMDLINE

    # Marker file for identification
    cat > "$boot_dir/nabla-otp.txt" <<'MARKER'
Nabla OTP Enabler SD Card
==========================
This SD card programs the Pi 3B OTP fuse for USB boot.
Boot once with this card, then use USB drives.

Created by: nabla-image write-otp
MARKER
}

create_image() {
    local img="$OUTPUT"
    local img_size_bytes=$((IMAGE_SIZE_MB * 1024 * 1024))
    local loop_dev=""
    local mount_point=""
    
    log "Creating image: $img (${IMAGE_SIZE_MB}MB)"
    
    # Create empty image
    dd if=/dev/zero of="$img" bs=1M count="$IMAGE_SIZE_MB" status=progress 2>/dev/null
    
    # Create partition table (MBR with single FAT32 partition)
    log "Creating partition table..."
    parted -s "$img" mklabel msdos
    parted -s "$img" mkpart primary fat32 1MiB 100%
    parted -s "$img" set 1 boot on
    parted -s "$img" set 1 lba on
    
    # Set up loop device
    loop_dev=$(losetup -f --show -P "$img")
    log "Loop device: $loop_dev"
    
    # Wait for partition to appear
    sleep 1
    partprobe "$loop_dev" 2>/dev/null || true
    sleep 1
    
    local part="${loop_dev}p1"
    [ -b "$part" ] || part="${loop_dev}1"
    [ -b "$part" ] || err "Partition not found: expected ${loop_dev}p1 or ${loop_dev}1"
    
    # Format as FAT32
    log "Formatting FAT32..."
    mkfs.vfat -F 32 -n NABLA_OTP "$part"
    
    # Mount and copy files
    mount_point=$(mktemp -d)
    mount "$part" "$mount_point"
    
    log "Copying boot files..."
    
    # GPU firmware
    cp "$CACHE_DIR/firmware/bootcode.bin" "$mount_point/"
    cp "$CACHE_DIR/firmware/start.elf" "$mount_point/"
    cp "$CACHE_DIR/firmware/fixup.dat" "$mount_point/"
    
    # Use cut-down firmware if available (saves ~1MB)
    if [ -f "$CACHE_DIR/firmware/start_cd.elf" ]; then
        cp "$CACHE_DIR/firmware/start_cd.elf" "$mount_point/"
        cp "$CACHE_DIR/firmware/fixup_cd.dat" "$mount_point/"
    fi
    
    # Kernel
    cp "$CACHE_DIR/kernel/kernel8.img" "$mount_point/"
    
    # Device trees
    cp "$CACHE_DIR/kernel/"*.dtb "$mount_point/"
    
    # Initramfs
    cp "$CACHE_DIR/initramfs8" "$mount_point/"
    
    # Config files
    cp "$CACHE_DIR/boot/config.txt" "$mount_point/"
    cp "$CACHE_DIR/boot/cmdline.txt" "$mount_point/"
    cp "$CACHE_DIR/boot/nabla-otp.txt" "$mount_point/"
    
    # Show what we put in there
    log "Boot partition contents:"
    ls -lh "$mount_point/"
    
    local used_kb=$(du -sk "$mount_point" | cut -f1)
    local used_mb=$((used_kb / 1024))
    log "Total size: ${used_mb}MB"
    
    # Cleanup
    sync
    umount "$mount_point"
    rmdir "$mount_point"
    losetup -d "$loop_dev"
    
    log "Image created: $img"
    ls -lh "$img"
}

# Parse arguments
CLEAN=0
FROM_PIOS=""

while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output) OUTPUT="$2"; shift 2 ;;
        -c|--cache-dir) CACHE_DIR="$2"; shift 2 ;;
        -s|--size) IMAGE_SIZE_MB="$2"; shift 2 ;;
        --from-pios) FROM_PIOS="$2"; shift 2 ;;
        --clean) CLEAN=1; shift ;;
        -h|--help) usage ;;
        *) err "Unknown option: $1" ;;
    esac
done

main() {
    check_deps
    
    mkdir -p "$CACHE_DIR"
    
    if [ "$CLEAN" -eq 1 ]; then
        log "Cleaning cache..."
        rm -rf "$CACHE_DIR"/*
    fi
    
    log "=== Nabla OTP Enabler Image Builder v$VERSION ==="
    log "Output: $OUTPUT"
    log "Cache: $CACHE_DIR"
    log ""
    
    # Download components
    download_firmware
    download_kernel_dtbs
    download_busybox
    
    # Build initramfs
    create_initramfs
    
    # Create config files
    create_boot_files
    
    # Build the image
    create_image
    
    log ""
    log "=== Build complete ==="
    log "Write to SD card with:"
    log "  sudo dd if=$OUTPUT of=/dev/sdX bs=4M status=progress"
    log "  sync"
}

main

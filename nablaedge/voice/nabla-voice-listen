#!/usr/bin/env python3
"""
nabla-voice-listen — HTTP endpoint to trigger Wyoming satellite listening

Provides a simple HTTP server that triggers the satellite to start listening.
This enables remote triggering from:
- Home Assistant dashboard buttons
- HA Companion app
- Automations / scripts
- Any HTTP client

The satellite must already be running and connected to HA.

Usage:
  nabla-voice-listen                    # Start HTTP server on :10701
  nabla-voice-listen --port 10701       # Custom port
  curl http://pi-hostname:10701/listen  # Trigger from anywhere

Configuration: /etc/nabla-edge/voice.conf
  PORT=10700              # Wyoming satellite port
  LISTEN_HTTP_PORT=10701  # This HTTP trigger port

In Home Assistant:
  1. Create a shell_command or rest_command to POST to /listen
  2. Add a button to your dashboard that calls this command
  3. Or use an automation triggered by phone presence, NFC, etc.
"""

import os
import sys
import time
import json
import socket
import logging
from http.server import HTTPServer, BaseHTTPRequestHandler
from pathlib import Path
from urllib.parse import urlparse

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [listen] %(message)s',
    datefmt='%H:%M:%S'
)
log = logging.getLogger(__name__)

CONFIG_FILE = "/etc/nabla-edge/voice.conf"
DEFAULT_SATELLITE_PORT = 10700
DEFAULT_HTTP_PORT = 10701


def load_config() -> dict:
    """Load configuration from voice.conf file."""
    config = {
        "PORT": DEFAULT_SATELLITE_PORT,
        "LISTEN_HTTP_PORT": DEFAULT_HTTP_PORT,
        "SATELLITE_NAME": "edge",
    }
    
    config_path = Path(CONFIG_FILE)
    if config_path.exists():
        with open(config_path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    key, _, value = line.partition("=")
                    key = key.strip()
                    value = value.strip()
                    if key in config:
                        if key in ("PORT", "LISTEN_HTTP_PORT"):
                            config[key] = int(value)
                        else:
                            config[key] = value
    
    return config


def trigger_satellite(port: int) -> tuple[bool, str]:
    """
    Send a detection event to the local Wyoming satellite to start listening.
    
    This is the same mechanism used by wake-word detection. When the satellite
    receives a 'detection' event, it starts the Assist pipeline (begins 
    recording and sends audio to HA for STT).
    
    Returns (success: bool, message: str)
    """
    try:
        # Wyoming protocol uses newline-delimited JSON
        # A 'detection' event triggers the wake-word-detected state
        event = {
            "type": "event",
            "data": {
                "type": "detection",
                "data": {
                    "name": "remote",
                    "timestamp": int(time.time() * 1000)
                }
            }
        }
        
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(("127.0.0.1", port))
        
        message = json.dumps(event) + "\n"
        sock.sendall(message.encode("utf-8"))
        sock.close()
        
        log.info(f"Triggered satellite on port {port}")
        return True, "Satellite triggered - listening started"
        
    except ConnectionRefusedError:
        msg = f"Satellite not running on port {port}"
        log.warning(msg)
        return False, msg
    except Exception as e:
        msg = f"Failed to trigger satellite: {e}"
        log.warning(msg)
        return False, msg


class ListenHandler(BaseHTTPRequestHandler):
    """HTTP request handler for the listen endpoint."""
    
    satellite_port = DEFAULT_SATELLITE_PORT
    
    def log_message(self, format, *args):
        log.info("%s - %s", self.address_string(), format % args)
    
    def send_json(self, status: int, data: dict):
        """Send a JSON response."""
        body = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", len(body))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)
    
    def do_GET(self):
        """Handle GET requests."""
        path = urlparse(self.path).path
        
        if path == "/listen" or path == "/":
            success, message = trigger_satellite(self.satellite_port)
            status = 200 if success else 503
            self.send_json(status, {"success": success, "message": message})
        
        elif path == "/health":
            self.send_json(200, {"status": "ok", "satellite_port": self.satellite_port})
        
        else:
            self.send_json(404, {"error": "Not found", "endpoints": ["/listen", "/health"]})
    
    def do_POST(self):
        """Handle POST requests (same as GET for /listen)."""
        self.do_GET()
    
    def do_OPTIONS(self):
        """Handle CORS preflight."""
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()


def run_server(http_port: int, satellite_port: int):
    """Run the HTTP server."""
    ListenHandler.satellite_port = satellite_port
    
    server = HTTPServer(("0.0.0.0", http_port), ListenHandler)
    log.info(f"Starting listen server on http://0.0.0.0:{http_port}")
    log.info(f"Satellite port: {satellite_port}")
    log.info(f"Endpoints: /listen (trigger), /health (status)")
    log.info("Press Ctrl+C to stop")
    
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log.info("Shutting down...")
        server.shutdown()


def main():
    import argparse
    
    parser = argparse.ArgumentParser(
        description="HTTP endpoint to trigger Wyoming satellite listening"
    )
    parser.add_argument(
        "--port", type=int,
        help=f"HTTP server port (default: {DEFAULT_HTTP_PORT})"
    )
    parser.add_argument(
        "--satellite-port", type=int,
        help=f"Wyoming satellite port (default: {DEFAULT_SATELLITE_PORT})"
    )
    parser.add_argument(
        "--config", default=CONFIG_FILE,
        help=f"Config file path (default: {CONFIG_FILE})"
    )
    args = parser.parse_args()
    
    global CONFIG_FILE
    CONFIG_FILE = args.config
    
    config = load_config()
    
    http_port = args.port or config.get("LISTEN_HTTP_PORT", DEFAULT_HTTP_PORT)
    satellite_port = args.satellite_port or config.get("PORT", DEFAULT_SATELLITE_PORT)
    
    run_server(http_port, satellite_port)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
"""
nabla-voice-ptt — GPIO Push-to-Talk trigger for Wyoming satellite

Watches a GPIO button and triggers Home Assistant Assist conversation
when pressed. Designed for Raspberry Pi with Wyoming satellite in button mode.

The satellite must be registered in HA as a Wyoming integration first.
This script detects button presses and tells HA to start listening.

Configuration: /etc/nabla-edge/voice.conf
  GPIO_PIN=17
  HA_URL=https://example.invalid
  HA_TOKEN_FILE=/etc/nabla-edge/ha-token
  SATELLITE_NAME=edge01

Usage:
  nabla-voice-ptt              # Run as foreground process
  systemctl --user start nabla-voice-ptt  # Via systemd
"""

import os
import sys
import time
import signal
import logging
from pathlib import Path

logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [PTT] %(message)s',
    datefmt='%H:%M:%S'
)
log = logging.getLogger(__name__)

# Configuration defaults
CONFIG_FILE = "/etc/nabla-edge/voice.conf"
DEFAULT_GPIO_PIN = 17
DEFAULT_DEBOUNCE_MS = 200


def load_config() -> dict:
    """Load configuration from voice.conf file."""
    config = {
        "GPIO_PIN": DEFAULT_GPIO_PIN,
        "HA_URL": "",
        "HA_TOKEN_FILE": "/etc/nabla-edge/ha-token",
        "SATELLITE_NAME": "edge",
        "PORT": 10700,
    }
    
    config_path = Path(CONFIG_FILE)
    if config_path.exists():
        with open(config_path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    key, _, value = line.partition("=")
                    key = key.strip()
                    value = value.strip()
                    if key in config:
                        if key == "GPIO_PIN" or key == "PORT":
                            config[key] = int(value)
                        else:
                            config[key] = value
    
    # Load token from file
    token_path = Path(config["HA_TOKEN_FILE"])
    if token_path.exists():
        config["HA_TOKEN"] = token_path.read_text().strip()
    else:
        config["HA_TOKEN"] = ""
    
    return config


def trigger_assist_via_wyoming(port: int) -> bool:
    """
    Send a detection event to the local Wyoming satellite.
    
    Wyoming protocol: when the satellite receives a 'detection' event,
    it starts the pipeline (begins listening for voice command).
    This is the cleanest approach as it works through the standard
    Wyoming event flow.
    """
    import socket
    import json
    
    try:
        # Wyoming protocol uses newline-delimited JSON
        # A 'detection' event triggers the wake-word-detected state
        event = {
            "type": "event",
            "data": {
                "type": "detection",
                "data": {
                    "name": "button",
                    "timestamp": int(time.time() * 1000)
                }
            }
        }
        
        # Connect to local satellite
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(("127.0.0.1", port))
        
        # Send detection event
        message = json.dumps(event) + "\n"
        sock.sendall(message.encode("utf-8"))
        sock.close()
        
        log.info("Sent detection event to Wyoming satellite")
        return True
        
    except Exception as e:
        log.warning(f"Wyoming trigger failed: {e}")
        return False


def trigger_assist_via_ha_rest(config: dict) -> bool:
    """
    Trigger Assist conversation via Home Assistant REST API.
    
    Calls the assist_satellite.start_conversation service if available,
    or conversation.process as fallback.
    """
    import urllib.request
    import urllib.error
    import json
    
    ha_url = config.get("HA_URL", "").rstrip("/")
    token = config.get("HA_TOKEN", "")
    satellite_name = config.get("SATELLITE_NAME", "edge")
    
    if not ha_url or not token or token == "CHANGE_ME":
        log.warning("HA_URL or HA_TOKEN not configured, skipping REST trigger")
        return False
    
    # Try assist_satellite.start_conversation first
    # This service exists if the satellite is registered as an Assist Satellite
    entity_id = f"assist_satellite.{satellite_name}"
    
    api_url = f"{ha_url}/api/services/assist_satellite/start_conversation"
    payload = json.dumps({"entity_id": entity_id}).encode("utf-8")
    
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }
    
    try:
        req = urllib.request.Request(api_url, data=payload, headers=headers, method="POST")
        with urllib.request.urlopen(req, timeout=5) as resp:
            if resp.status == 200:
                log.info(f"Triggered Assist via HA REST: {entity_id}")
                return True
    except urllib.error.HTTPError as e:
        if e.code == 404:
            log.debug("assist_satellite.start_conversation not available")
        else:
            log.warning(f"HA REST error: {e.code}")
    except Exception as e:
        log.warning(f"HA REST trigger failed: {e}")
    
    return False


def on_button_press(config: dict):
    """Handle button press event."""
    log.info("Button pressed! Triggering Assist...")
    
    # Primary: send detection event to local Wyoming satellite
    # This is the cleanest approach as it uses the standard wake-word flow
    if trigger_assist_via_wyoming(config.get("PORT", 10700)):
        return
    
    # Fallback: call HA REST API directly
    if trigger_assist_via_ha_rest(config):
        return
    
    log.warning("Could not trigger Assist (neither Wyoming nor HA REST worked)")


def run_gpio_watcher(config: dict):
    """Main loop watching GPIO button."""
    gpio_pin = config.get("GPIO_PIN", DEFAULT_GPIO_PIN)
    
    try:
        from gpiozero import Button
        from gpiozero.pins.lgpio import LGPIOFactory
    except ImportError:
        log.error("gpiozero not installed. Run: pip install gpiozero lgpio")
        sys.exit(1)
    
    try:
        # Use lgpio backend (works on Pi 5 and older)
        button = Button(
            gpio_pin,
            pull_up=True,
            bounce_time=DEFAULT_DEBOUNCE_MS / 1000.0,
            pin_factory=LGPIOFactory()
        )
    except Exception as e:
        log.warning(f"lgpio failed ({e}), trying default factory...")
        try:
            button = Button(
                gpio_pin,
                pull_up=True,
                bounce_time=DEFAULT_DEBOUNCE_MS / 1000.0
            )
        except Exception as e2:
            log.error(f"Cannot initialize GPIO: {e2}")
            log.error("Ensure you're on a Raspberry Pi with GPIO access")
            sys.exit(1)
    
    log.info(f"Watching GPIO{gpio_pin} for button press (pull-up, active-low)")
    log.info("Press Ctrl+C to exit")
    
    # Set up button callback
    button.when_pressed = lambda: on_button_press(config)
    
    # Keep running
    try:
        signal.pause()
    except KeyboardInterrupt:
        log.info("Exiting...")


def run_test_mode(config: dict):
    """Test mode: simulate button press without GPIO."""
    log.info("Test mode: simulating button press in 2 seconds...")
    time.sleep(2)
    on_button_press(config)
    log.info("Test complete")


def main():
    import argparse
    
    parser = argparse.ArgumentParser(
        description="GPIO Push-to-Talk trigger for Wyoming satellite"
    )
    parser.add_argument(
        "--test",
        action="store_true",
        help="Test mode: simulate button press without GPIO"
    )
    parser.add_argument(
        "--config",
        default=CONFIG_FILE,
        help=f"Config file path (default: {CONFIG_FILE})"
    )
    args = parser.parse_args()
    
    global CONFIG_FILE
    CONFIG_FILE = args.config
    
    config = load_config()
    
    log.info(f"Config: GPIO{config['GPIO_PIN']}, satellite={config['SATELLITE_NAME']}")
    
    if args.test:
        run_test_mode(config)
    else:
        run_gpio_watcher(config)


if __name__ == "__main__":
    main()

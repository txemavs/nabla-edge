# Nabla Edge Voice Satellite Configuration (Linux Voice Assistant)
# Copy to /etc/nabla-edge/voice.conf and customize
#
# See: nablaedge/docs/voice-satellite/README.md

# Mode: button (HA start_conversation) or wake (local wake word)
# - button: Trigger via HA dashboard button (recommended for wall-mounted Pi)
# - wake: Continuous wake word detection (uses more CPU)
MODE=button

# Satellite name (appears in HA as assist_satellite.<name>_satellite_assist)
SATELLITE_NAME=demo

# ESPHome port (default 6053)
# HA adds via ESPHome integration using this port
PORT=6053

# Wake word name (when MODE=wake)
# Available: hey_jarvis, ok_nabu, alexa, hey_mycroft
WAKE_WORD=hey_jarvis

# GPIO pin for optional physical button (BCM numbering)
# Connect between GPIO pin and GND for manual trigger
GPIO_PIN=17

# Wyoming Voice Satellite — Systemd User Service Template
#
# This is a TEMPLATE showing the service structure.
# The actual service is generated by install-voice-satellite.sh
# and installed to ~/.config/systemd/user/wyoming-satellite.service
#
# Manual installation:
#   1. Copy this template to ~/.config/systemd/user/wyoming-satellite.service
#   2. Edit paths and configuration as needed
#   3. Run: systemctl --user daemon-reload
#   4. Run: systemctl --user enable --now wyoming-satellite
#
# For button mode, also enable nabla-voice-ptt.service

[Unit]
Description=Wyoming Voice Satellite (Nabla Edge)
Documentation=https://github.com/rhasspy/wyoming-satellite
After=network.target sound.target
Wants=network.target

[Service]
Type=simple

# Configuration file with MODE, SATELLITE_NAME, PORT, etc.
EnvironmentFile=/etc/nabla-edge/voice.conf

# The wyoming-satellite command
# NOTE: Use 'python -m wyoming_satellite' (module form is more reliable)
# NOTE: We do NOT use --vad, --mic-auto-gain, or webrtc extras by default
#       (they can cause SIGILL on old CPUs)
ExecStart=/opt/nabla-edge/voice/venv/bin/python -m wyoming_satellite \
    --uri tcp://0.0.0.0:${PORT:-10700} \
    --name ${SATELLITE_NAME:-edge} \
    --mic-command "arecord -r 16000 -c 1 -f S16_LE -t raw -D ${MIC_DEVICE:-default}" \
    --snd-command "aplay -r 22050 -c 1 -f S16_LE -t raw -D ${SPK_DEVICE:-default}"

# For WAKE mode, add these arguments:
#   --wake-uri tcp://127.0.0.1:10400 \
#   --wake-word-name hey_jarvis

Restart=on-failure
RestartSec=5

# Resource limits (optional, useful for Pi)
# MemoryMax=256M

[Install]
WantedBy=default.target
